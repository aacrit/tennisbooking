# McFetridge Tennis Court Monitor - Environment Variables

# WhatsApp notifications via Green API (https://green-api.com)
# 1. Sign up and create a free Developer instance
# 2. Scan QR code to link your WhatsApp
# 3. Set these three values (REQUIRED for notifications):
GREEN_API_INSTANCE_ID=your-instance-id
GREEN_API_TOKEN=your-api-token
WHATSAPP_CHAT_ID=1XXXXXXXXXX@c.us

# API polling (lightweight HTTP checks between Playwright scans)
API_POLL_ENABLED=true
API_POLL_PEAK_SECONDS=15
API_POLL_NORMAL_SECONDS=120
NOTIFY_COOLDOWN_SECONDS=60

# Time filters (optional - defaults shown)
WEEKDAY_EARLIEST_HOUR=18
DAYS_AHEAD=6

# Web server (optional)
HOST=0.0.0.0
PORT=8080

# Database (optional)
DB_PATH=data/tennisbooking.db

# Debug (set to true to run browser in headed mode)
DEBUG_HEADED=false
