# McFetridge Tennis Court Monitor - Environment Variables

# [GITHUB-PAGES] Email disabled for static deployment
# Uncomment below to re-enable email notifications:
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# FROM_EMAIL=your-email@gmail.com
# NOTIFY_EMAIL=aacritm@gmail.com

# Scanning schedule (optional - defaults shown)
PEAK_INTERVAL_MINUTES=5
NORMAL_INTERVAL_MINUTES=45

# Time filters (optional - defaults shown)
WEEKDAY_EARLIEST_HOUR=18

# Web server (optional)
HOST=0.0.0.0
PORT=8080

# Database (optional)
DB_PATH=data/tennisbooking.db

# Debug (set to true to run browser in headed mode)
DEBUG_HEADED=false
